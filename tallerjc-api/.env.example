# Plantilla de configuracion del API.
# Copiar como .env y completar con los valores reales del servidor.
# El archivo .env NUNCA se sube al repositorio.

DB_SERVER=localhost
DB_DATABASE=NOMBRE_BASE_DATOS
DB_USER=USUARIO_SQL
DB_PASSWORD=CLAVE_SQL
DB_PORT=1433

# Clave para firmar los tokens JWT. Usar una cadena larga y aleatoria.
JWT_SECRET=CAMBIAR_POR_CADENA_ALEATORIA_LARGA

API_PORT=3000
